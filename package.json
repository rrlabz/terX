{
  "name": "terx",
  "version": "1.0.0",
  "description": "terX SSH client",
  "main": "dist/main/index.js",
  "homepage": "./",
  "author": "Rahul R",
  "repository": {
    "type": "git",
    "url": "https://github.com/rrlabz/terX.git"
  },
  "license": "MIT",
  "scripts": {
    "start": "npm run start:dev",
    "start:dev": "concurrently \"npm run start:react\" \"npm run _start:electron\"",
    "_start:electron": "cross-env NODE_ENV=development electron .",
    "start:react": "vite",
    "build": "npm run build:react && npm run build:electron",
    "build:react": "vite build",
    "build:electron": "tsc",
    "start:built": "cross-env NODE_ENV=production electron .",
    "build:portable": "npm run build && electron-builder --win portable",
    "build:setup": "npm run build && electron-builder --win nsis",
    "test": "vitest run",
    "clean": "taskkill /F /IM \"terX.exe\" 2>nul & taskkill /F /IM electron.exe 2>nul & rd /s /q dist"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-is-dev": "^2.0.0",
    "node-pty": "^1.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^26.8.1",
    "typescript": "^4.9.0",
    "vite": "^8.0.9",
    "vitest": "^4.1.4",
    "wait-on": "^9.0.5"
  },
  "build": {
    "extends": null,
    "appId": "com.rrlabz.terX",
    "productName": "terX",
    "icon": "app_icon.ico",
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "build/**/*",
      "package.json",
      "!**/*.map",
      "!**/test/**",
      "!**/__tests__/**",
      "!**/.vscode/**",
      "!**/.git/**"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "directories": {
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/app_icon.ico"
    },
    "nsis": {
      "installerIcon": "build/app_icon.ico",
      "uninstallerIcon": "build/app_icon.ico",
      "installerHeaderIcon": "build/app_icon.ico"
    }
  }
}